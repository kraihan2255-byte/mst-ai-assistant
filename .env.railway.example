# ==============================================================================
# MST Tengapal — Railway Environment Variables Configuration
# ==============================================================================

# 1. Environment & Port
NODE_ENV=production
# PORT is automatically injected by Railway (no need to change)

# 2. Database Connection
# When you add a PostgreSQL plugin on Railway, this is automatically linked:
# DATABASE_URL=postgresql://${{PGUSER}}:${{PGPASSWORD}}@${{PGHOST}}:${{PGPORT}}/${{PGDATABASE}}

# 3. Security & Authentication
JWT_SECRET=mst-tengapal-production-secret-change-this-random-string-2026
COOKIE_SECURE=true
APP_PIN=1234
QUICK_ACCESS_ENABLED=true

# 4. Cloud AI Provider (Groq / Cloudflare / OpenAI)
# Recommended: Free Groq API Key from https://console.groq.com
AI_PROVIDER=groq
GROQ_API_KEY=gsk_your_groq_api_key_here
AI_MODEL=llama-3.3-70b-versatile

# Optional alternative: If using OpenAI or Cloudflare Workers AI
# AI_PROVIDER=openai
# OPENAI_API_KEY=sk-...
# AI_BASE_URL=https://api.openai.com/v1
# AI_MODEL=gpt-4o-mini
