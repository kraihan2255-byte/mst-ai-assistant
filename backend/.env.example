# Application Environment
NODE_ENV=production
PORT=3000

# PostgreSQL Connection (Native Homebrew on macOS)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/mst_tengapal?schema=public"

# Local Ollama Inference Runtime (macOS host)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:4b
OLLAMA_TIMEOUT_MS=30000

# Authentication & Session Security (Generate a secure random key for production)
JWT_SECRET=change-this-to-a-secure-random-secret-in-production-mst-tengapal
JWT_EXPIRES_IN=7d
COOKIE_SECURE=true

# CORS Allowed Origins (Comma-separated for Tailscale domain)
CORS_ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
